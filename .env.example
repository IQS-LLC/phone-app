# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
# Comma-separated list, added on top of the built-in local/LAN dev hosts
# (localhost, 127.0.0.1, 10.0.2.2, etc. — see PLC_Project/settings.py)
EXTRA_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database Configuration (PostgreSQL) — must match docker-compose.dev.yml's db service
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lugh_db
DB_USER=lugh_user
DB_PASSWORD=your-db-password-here
DB_HOST=db
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Gunicorn Configuration
GUNICORN_LOG_LEVEL=info
# Keep at 1 unless PLC state is moved to a shared backend — see the comment
# in gunicorn.conf.py for why more workers means duplicate ADS connections.
GUNICORN_WORKERS=1

# TwinCAT / Beckhoff PLC — Apartment 16
# Set PLC_MOCK=False to enable real ADS communication (requires TwinCAT route)
PLC_MOCK=True
# AMS Net ID from TwinCAT System Manager → Router (e.g. 192.168.0.161.1.1)
PLC_NETID=5.168.214.72.1.1
# IP address of the machine running TwinCAT
PLC_IP=192.168.0.161
# This host's own AMS Net ID — must match the route registered on the CX
# (added via ADSClient.add_route / TwinCAT System Manager Routes tab).
# Without this, pyads defaults to an unroutable local identity and real
# ADS connections fail route validation on the target.
LOCAL_AMS_NET_ID=192.168.0.158.1.1
LOCAL_AMS_HOST=192.168.0.158

# Optional — lets ADSClient auto-repair its AMS route on the target when
# TwinCAT resets it (a project rebuild/reactivate/redownload clears dynamic
# routes). Same credentials used to log into TwinCAT / the CX's embedded OS.
# Leave unset to disable auto-repair (connect() just fails and retries on
# the normal exponential-backoff schedule instead).
PLC_ROUTE_USERNAME=Administrator
PLC_ROUTE_PASSWORD=your-twincat-password-here