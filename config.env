# ============================================
# PLC Demo Configuration
# ============================================

# Scenarios:
# - LOCAL_DEV: emulator on PC (use 10.0.2.2)
# - LAN: real phone on same WiFi (use 192.168.0.161 or your PC IP)
# - PRODUCTION: real phone on internet (use backend domain)

SCENARIO=LOCAL_DEV

# API Endpoint (auto-set by scenario, override here if needed)
API_ENDPOINT=http://10.0.2.2:8000

# Django settings
DJANGO_PORT=8000
DJANGO_HOST=0.0.0.0

# Flutter device (leave empty for auto-select, or set to device ID)
FLUTTER_DEVICE=

# For LAN/production, set your PC/server IP:
# API_ENDPOINT=http://192.168.0.161:8000
# or
# API_ENDPOINT=https://your-backend.com:8000
