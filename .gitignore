# ── Python / Django ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Django
db.sqlite3
db.sqlite3-journal
/static/
/media/
local_settings.py

# Logs
logs/
*.log

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example
# Also catch a differently-named env file (e.g. config.env) — found one
# committed to the repo's original scaffold commit 2026-08-24 (no real
# secrets in it, but the *.env glob below was missing, so a filename that
# doesn't start with a literal dot wasn't excluded at all). See
# docs/AUDIT_FINDINGS.md.
*.env
!.env.example

# Test / coverage
.coverage
.coverage.*
htmlcov/
.tox/
.pytest_cache/
nosetests.xml
coverage.xml

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Flutter / Dart ───────────────────────────────────────────────────────────
# (flutter_application_plc/ has its own .gitignore for build artifacts;
# these are repo-root-relative safety nets for the same patterns)
flutter_application_plc/.dart_tool/
flutter_application_plc/.flutter-plugins
flutter_application_plc/.flutter-plugins-dependencies
flutter_application_plc/build/
flutter_application_plc/.pub-cache/
flutter_application_plc/.pub/
flutter_application_plc/android/app/debug/
flutter_application_plc/android/app/profile/
flutter_application_plc/android/app/release/
flutter_application_plc/android/.gradle/
flutter_application_plc/ios/Pods/
flutter_application_plc/ios/.symlinks/
flutter_application_plc/windows/flutter/ephemeral/
flutter_application_plc/linux/flutter/ephemeral/
flutter_application_plc/macos/Flutter/ephemeral/

# Generated runner manifest (regenerated by `flutter build windows`)
flutter_application_plc/windows/runner/runner.exe.manifest
